<?xml version="1.0" encoding="UTF-8"?>
<!--
    Versión 80 mm basada en Factura.jrxml. Diseñada para impresión térmica, sin logo del emisor/cliente.

    ÁREA SEGURA DE IMPRESIÓN (80 mm)
    ================================
    Papel:              79.5 ± 0.5 mm  -> pageWidth  = 227 pt (80.08 mm)
    Área imprimible:    72.2 ± 0.2 mm  -> columnWidth = 204 pt (71.97 mm)
    Zona muerta:        ~3.7 mm por lado (el cabezal térmico no tiene resistencias)
                        -> leftMargin = 11 pt (3.88 mm) / rightMargin = 12 pt (4.23 mm)

    Conversión: 1 mm = 2.8346 pt  |  203 DPI = 8 dots/mm  |  72 mm = 576 dots
    Ref.: Epson TM-T88 Technical Reference Guide (printable area 72.2 mm / 512 dots @180dpi)

    NINGÚN elemento debe superar x + width > 204.
    Se deja ~16 pt de avance en blanco al final del summary para el corte del autocutter.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
              name="Factura80mm"
              pageWidth="227"
              pageHeight="842"
              columnWidth="204"
              leftMargin="11"
              rightMargin="12"
              topMargin="5"
              bottomMargin="5"
              isIgnorePagination="true"
              uuid="4fcdcf1a-9d24-4c3d-90b6-23ac4c2b47d8">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <style name="TicketHeader" mode="Transparent" forecolor="#000000"/>
    <style name="TicketCell">
        <box>
            <bottomPen lineWidth="0.25" lineColor="#777777"/>
        </box>
    </style>

    <subDataset name="dsItemsFactura " uuid="b2bb52c2-bf09-4c88-969a-8185c10c99bf">
        <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
        <queryString><![CDATA[]]></queryString>
        <field name="cantidad" class="java.lang.String"/>
        <field name="descripcion" class="java.lang.String"/>
        <field name="precioUnitario" class="java.lang.String"/>
        <field name="exentas" class="java.lang.String"/>
        <field name="iva5" class="java.lang.String"/>
        <field name="iva10" class="java.lang.String"/>
    </subDataset>

    <!-- Se conservan exactamente los mismos parámetros de entrada del diseño original. -->
    <parameter name="empresaLogo" class="java.lang.String"/>
    <parameter name="facturaId" class="java.lang.String"/>
    <parameter name="ds" class="net.sf.jasperreports.engine.data.JRBeanArrayDataSource"/>
    <parameter name="fechaHora" class="java.lang.String"/>
    <parameter name="condicionVenta" class="java.lang.String"/>
    <parameter name="moneda" class="java.lang.String"/>
    <parameter name="ruc" class="java.lang.String"/>
    <parameter name="razonSocial" class="java.lang.String"/>
    <parameter name="correoElectronico" class="java.lang.String"/>
    <parameter name="total" class="java.lang.String"/>
    <parameter name="totalIva" class="java.lang.String"/>
    <parameter name="totalIva5" class="java.lang.String"/>
    <parameter name="totalIva10" class="java.lang.String"/>
    <parameter name="qr" class="java.lang.String"/>
    <parameter name="cdc" class="java.lang.String"/>
    <parameter name="empresaRuc" class="java.lang.String"/>
    <parameter name="empresaTimbrado" class="java.lang.String"/>
    <parameter name="empresaVigenteDesde" class="java.lang.String"/>
    <parameter name="empresaNombre" class="java.lang.String"/>
    <parameter name="empresaDireccion" class="java.lang.String"/>
    <parameter name="empresaCorreoElectronico" class="java.lang.String"/>
    <parameter name="empresaCiudad" class="java.lang.String"/>
    <parameter name="empresaTelefono" class="java.lang.String"/>
    <parameter name="tipoDocumento" class="java.lang.String"/>
    <parameter name="tipoDocumentoTop" class="java.lang.String"/>
    <parameter name="tipoCredito" class="java.lang.String"/>
    <parameter name="creditoCuotaCantidad" class="java.lang.String"/>
    <parameter name="creditoCuotaPeriodicidad" class="java.lang.String"/>
    <parameter name="creditoAPlazoDescripcion" class="java.lang.String"/>
    <parameter name="factyble" class="java.lang.String"/>

    <queryString><![CDATA[]]></queryString>

    <!-- CONTADO -->
    <group name="grpContado80">
        <groupExpression><![CDATA[$P{condicionVenta}]]></groupExpression>
        <groupHeader>
            <band height="74">
                <printWhenExpression><![CDATA[$P{condicionVenta} != null && $P{condicionVenta}.equals("CONTADO")]]></printWhenExpression>

                <line><reportElement x="0" y="2" width="204" height="1"/></line>
                <staticText><reportElement x="0" y="6" width="53" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Fecha/hora:]]></text></staticText>
                <textField><reportElement x="53" y="6" width="151" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{fechaHora}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="19" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[RUC/CI:]]></text></staticText>
                <textField><reportElement x="40" y="19" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{ruc}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="32" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Cliente:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="40" y="32" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{razonSocial}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="45" width="52" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Condición:]]></text></staticText>
                <textField><reportElement x="52" y="45" width="48" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{condicionVenta}]]></textFieldExpression></textField>
                <staticText><reportElement x="100" y="45" width="38" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Moneda:]]></text></staticText>
                <textField><reportElement x="138" y="45" width="66" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{moneda}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="58" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Email:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="40" y="58" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{correoElectronico}]]></textFieldExpression></textField>
                <line><reportElement x="0" y="72" width="204" height="1"/></line>
            </band>
        </groupHeader>
    </group>

    <!-- CRÉDITO / CUOTA -->
    <group name="grpCreditoCuota80">
        <groupExpression><![CDATA[$P{condicionVenta}]]></groupExpression>
        <groupHeader>
            <band height="100">
                <printWhenExpression><![CDATA[$P{condicionVenta} != null && $P{condicionVenta}.equals("CREDITO") && $P{tipoCredito} != null && $P{tipoCredito}.equals("CUOTA")]]></printWhenExpression>

                <line><reportElement x="0" y="2" width="204" height="1"/></line>
                <staticText><reportElement x="0" y="6" width="53" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Fecha/hora:]]></text></staticText>
                <textField><reportElement x="53" y="6" width="151" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{fechaHora}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="19" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[RUC/CI:]]></text></staticText>
                <textField><reportElement x="40" y="19" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{ruc}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="32" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Cliente:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="40" y="32" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{razonSocial}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="45" width="52" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Condición:]]></text></staticText>
                <textField><reportElement x="52" y="45" width="48" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{condicionVenta}]]></textFieldExpression></textField>
                <staticText><reportElement x="100" y="45" width="38" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Moneda:]]></text></staticText>
                <textField><reportElement x="138" y="45" width="66" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{moneda}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="58" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Email:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="40" y="58" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{correoElectronico}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="71" width="53" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Crédito:]]></text></staticText>
                <staticText><reportElement x="53" y="71" width="45" height="12"/><textElement><font size="7"/></textElement><text><![CDATA[CUOTA]]></text></staticText>
                <staticText><reportElement x="98" y="71" width="38" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Cuotas:]]></text></staticText>
                <textField><reportElement x="136" y="71" width="30" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{creditoCuotaCantidad}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="84" width="62" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Periodicidad:]]></text></staticText>
                <textField><reportElement x="62" y="84" width="142" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{creditoCuotaPeriodicidad}]]></textFieldExpression></textField>
                <line><reportElement x="0" y="98" width="204" height="1"/></line>
            </band>
        </groupHeader>
    </group>

    <!-- CRÉDITO / A PLAZO -->
    <group name="grpCreditoPlazo80">
        <groupExpression><![CDATA[$P{condicionVenta}]]></groupExpression>
        <groupHeader>
            <band height="110">
                <printWhenExpression><![CDATA[$P{condicionVenta} != null && $P{condicionVenta}.equals("CREDITO") && $P{tipoCredito} != null && $P{tipoCredito}.equals("A PLAZO")]]></printWhenExpression>

                <line><reportElement x="0" y="2" width="204" height="1"/></line>
                <staticText><reportElement x="0" y="6" width="53" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Fecha/hora:]]></text></staticText>
                <textField><reportElement x="53" y="6" width="151" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{fechaHora}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="19" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[RUC/CI:]]></text></staticText>
                <textField><reportElement x="40" y="19" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{ruc}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="32" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Cliente:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="40" y="32" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{razonSocial}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="45" width="52" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Condición:]]></text></staticText>
                <textField><reportElement x="52" y="45" width="48" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{condicionVenta}]]></textFieldExpression></textField>
                <staticText><reportElement x="100" y="45" width="38" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Moneda:]]></text></staticText>
                <textField><reportElement x="138" y="45" width="66" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{moneda}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="58" width="40" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Email:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="40" y="58" width="164" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{correoElectronico}]]></textFieldExpression></textField>
                <staticText><reportElement x="0" y="71" width="53" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Crédito:]]></text></staticText>
                <staticText><reportElement x="53" y="71" width="70" height="12"/><textElement><font size="7"/></textElement><text><![CDATA[A PLAZO]]></text></staticText>
                <staticText><reportElement x="0" y="84" width="62" height="12"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[Descripción:]]></text></staticText>
                <textField textAdjust="StretchHeight"><reportElement x="62" y="84" width="142" height="22"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$P{creditoAPlazoDescripcion}]]></textFieldExpression></textField>
                <line><reportElement x="0" y="108" width="204" height="1"/></line>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="134">
            <textField>
                <reportElement x="0" y="0" width="204" height="13"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{tipoDocumentoTop}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="15" width="204" height="1"/></line>

            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="19" width="204" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaNombre}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="36" width="204" height="13"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaDireccion}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="50" width="204" height="12"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[(($P{empresaCiudad} == null ? "" : $P{empresaCiudad}) + (($P{empresaTelefono} == null || $P{empresaTelefono}.trim().isEmpty()) ? "" : "  Tel: " + $P{empresaTelefono}))]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="63" width="204" height="12"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{empresaCorreoElectronico}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="77" width="204" height="12"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["RUC: " + ($P{empresaRuc} == null ? "" : $P{empresaRuc}) + "   Timbrado: " + ($P{empresaTimbrado} == null ? "" : $P{empresaTimbrado})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="90" width="204" height="12"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Vigente desde: " + ($P{empresaVigenteDesde} == null ? "" : $P{empresaVigenteDesde})]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="104" width="204" height="17"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{tipoDocumento}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="121" width="204" height="13"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{facturaId}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="95">
            <componentElement>
                <reportElement x="0" y="2" width="204" height="93"/>
                <jr:table>
                    <datasetRun subDataset="dsItemsFactura ">
                        <dataSourceExpression><![CDATA[$P{ds}]]></dataSourceExpression>
                    </datasetRun>

                    <jr:column width="204">
                        <jr:columnHeader style="TicketHeader" height="20">
                            <staticText>
                                <reportElement x="0" y="0" width="204" height="13" mode="Transparent" forecolor="#000000"/>
                                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7.5" isBold="true"/></textElement>
                                <text><![CDATA[ITEMS]]></text>
                            </staticText>
                            <line><reportElement x="0" y="17" width="204" height="1"/></line>
                        </jr:columnHeader>
                        <jr:detailCell style="TicketCell" height="68">
                            <textField textAdjust="StretchHeight">
                                <reportElement x="2" y="3" width="200" height="12"/>
                                <textElement><font size="7" isBold="true"/><paragraph leftIndent="1" rightIndent="1"/></textElement>
                                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
                            </textField>

                            <staticText>
                                <reportElement positionType="Float" x="2" y="17" width="55" height="11"/>
                                <textElement><font size="6.5" isBold="true"/><paragraph leftIndent="1"/></textElement>
                                <text><![CDATA[Cantidad:]]></text>
                            </staticText>
                            <textField>
                                <reportElement positionType="Float" x="57" y="17" width="145" height="11"/>
                                <textElement><font size="6.5"/></textElement>
                                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
                            </textField>

                            <staticText>
                                <reportElement positionType="Float" x="2" y="29" width="55" height="11"/>
                                <textElement><font size="6.5" isBold="true"/><paragraph leftIndent="1"/></textElement>
                                <text><![CDATA[P. Unit:]]></text>
                            </staticText>
                            <textField>
                                <reportElement positionType="Float" x="57" y="29" width="145" height="11"/>
                                <textElement><font size="6.5"/></textElement>
                                <textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression>
                            </textField>

                            <staticText>
                                <reportElement positionType="Float" x="2" y="41" width="55" height="11"/>
                                <textElement><font size="6.5" isBold="true"/><paragraph leftIndent="1"/></textElement>
                                <text><![CDATA[IVA:]]></text>
                            </staticText>
                            <textField>
                                <reportElement positionType="Float" x="57" y="41" width="145" height="11"/>
                                <textElement><font size="6.5"/></textElement>
                                <textFieldExpression><![CDATA[($F{exentas} != null && !$F{exentas}.trim().isEmpty() && !$F{exentas}.trim().equals("0")) ? "Exenta" : (($F{iva5} != null && !$F{iva5}.trim().isEmpty() && !$F{iva5}.trim().equals("0")) ? "5%" : "10%")]]></textFieldExpression>
                            </textField>

                            <staticText>
                                <reportElement positionType="Float" x="2" y="53" width="55" height="12"/>
                                <textElement><font size="7" isBold="true"/><paragraph leftIndent="1"/></textElement>
                                <text><![CDATA[Total:]]></text>
                            </staticText>
                            <textField>
                                <reportElement positionType="Float" x="57" y="53" width="145" height="12"/>
                                <textElement><font size="7" isBold="true"/></textElement>
                                <textFieldExpression><![CDATA[($F{exentas} != null && !$F{exentas}.trim().isEmpty() && !$F{exentas}.trim().equals("0")) ? $F{exentas} : (($F{iva5} != null && !$F{iva5}.trim().isEmpty() && !$F{iva5}.trim().equals("0")) ? $F{iva5} : $F{iva10})]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>
                </jr:table>
            </componentElement>
        </band>
    </detail>

    <summary>
        <band height="410" splitType="Stretch">
            <line><reportElement x="0" y="3" width="204" height="1"/></line>

            <staticText><reportElement x="0" y="7" width="117" height="18"/><textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><text><![CDATA[TOTAL:]]></text></staticText>
            <textField><reportElement x="117" y="7" width="87" height="18"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{total}]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="27" width="52" height="13"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[IVA 5%:]]></text></staticText>
            <textField><reportElement x="52" y="27" width="46" height="13"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$P{totalIva5}]]></textFieldExpression></textField>
            <staticText><reportElement x="100" y="27" width="52" height="13"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[IVA 10%:]]></text></staticText>
            <textField><reportElement x="152" y="27" width="52" height="13"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$P{totalIva10}]]></textFieldExpression></textField>

            <staticText><reportElement x="0" y="41" width="117" height="13"/><textElement><font size="7" isBold="true"/></textElement><text><![CDATA[TOTAL IVA:]]></text></staticText>
            <textField><reportElement x="117" y="41" width="87" height="13"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{totalIva}]]></textFieldExpression></textField>

            <line><reportElement x="0" y="57" width="204" height="1"/></line>

            <staticText>
                <reportElement x="0" y="62" width="204" height="24"/>
                <textElement textAlignment="Center"><font size="6.5"/></textElement>
                <text><![CDATA[Consulte la validez de esta Factura Electrónica con el número de CDC impreso en:]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="87" width="204" height="12"/>
                <textElement textAlignment="Center"><font size="6.5" isBold="true"/></textElement>
                <text><![CDATA[https://ekuatia.set.gov.py/consultas/]]></text>
            </staticText>

            <!-- QR centrado dentro del área imprimible: (204 - 120) / 2 = 42 -->
            <image onErrorType="Blank" scaleImage="RetainShape">
                <reportElement x="42" y="104" width="120" height="120"/>
                <imageExpression><![CDATA[$P{qr}]]></imageExpression>
            </image>

            <staticText><reportElement x="0" y="228" width="204" height="11"/><textElement textAlignment="Center"><font size="6" isBold="true"/></textElement><text><![CDATA[CDC]]></text></staticText>

PORT=
DATABASE_URL=
# Entorno de ejecución: 'desa' o 'prod'. Sólo con ENTORNO=prod se registran los cronjobs SIFEN
# (batch/poll/cleanup/vencimiento de certificados). 'desa' o sin definir = cronjobs deshabilitados.
ENTORNO=

#JWT
JWT_SECRET=
JWT_EXPIRES_IN=

#Servicios para obtener datos de cliente
# RUC (CONTRIBUYENTE) se resuelve contra la tabla local padron_ruc, ver padronRucPersistenciaService.js
URL_CI=
USER_CI=
PW_CI=
# Techo de espera (ms) del registro de identificaciones. El default de axios es SIN timeout, y esta
# consulta cuelga de los mismos requests sincronicos que la de RUC a SIFEN (buscador y caja).
TIMEOUT_CI=5000
# SIFEN (facturación electrónica nativa)
SIFEN_ENV=test
CERT_ENCRYPTION_KEY=
SIFEN_TRAZABILIDAD_RETENCION_DIAS=90
# Techo de espera (ms) de la consulta de RUC al WS siConsRUC. Cuelga de un request sincronico del
# usuario (buscador de clientes y emision desde caja), por eso NO usa los 90 s por defecto de la lib:
# agotarlo se traduce a "indeterminado" y cada caller aplica su politica, nunca rechaza el RUC.
SIFEN_CONSULTA_RUC_TIMEOUT_MS=5000
# Cron diario 08:00 que verifica contra SIFEN las filas de padron_ruc con origen=FABRICADO (las
# que inventa la emision cuando el RUC no esta y SIFEN no responde). Techo por corrida y pausa
# entre consultas: el WS y la IP son los mismos con los que emitimos.
PADRON_RUC_VERIFICACION_MAX_POR_CORRIDA=50
PADRON_RUC_VERIFICACION_PAUSA_MS=1000
# Umbral de intentos de envío para el AVISO TEMPRANO one-shot por Telegram (ya NO condena el lote a
# ERROR: eso lo maneja SIFEN_LOTE_MAX_HORAS_ENVIO). Con el backoff de abajo, 10 intentos ≈ 5h.
SIFEN_LOTE_MAX_INTENTOS=10
SIFEN_LOTE_BACKOFF_BASE_SEGUNDOS=60
SIFEN_LOTE_BACKOFF_CAP_SEGUNDOS=3600
# Presupuesto de TIEMPO (horas desde Lote.fecha_creacion) para reintentar el ENVÍO de un lote ante
# fallas de transporte sostenidas (SIFEN caído). Se reintenta con backoff hasta acá; recién pasado eso
# el lote pasa a ERROR (intervención manual). 96h/4 días es un techo realista de caída de SIFEN, muy por
# debajo del plazo de transmisión de 720h. Reemplaza el viejo tope por conteo que mataba lotes a las ~5h.
SIFEN_LOTE_MAX_HORAS_ENVIO=96
SIFEN_RED_SEGURIDAD_UMBRAL_MINUTOS=120
# Tope de reintentos de firma (firmarPendientes(), loteService.js) antes de escalar el documento a
# ERROR + alerta por Telegram — sin esto, un documento que nunca lograba firmarse (certificado vencido,
# datos fiscales incompletos) reintentaba cada 5 min para siempre sin que nadie se enterara.
SIFEN_FIRMA_MAX_INTENTOS=10
# Límite (horas desde fecha_creacion) para permitir el reintento manual de un documento en ERROR
# (POST /factura/reintentar-sifen, /notaDeCredito/reintentar-sifen) — 720h/30 días es el límite de
# "transmisión extemporánea" del Manual Técnico SIFEN v150 §6.2, más allá del cual SIFEN rechaza sin excepción.
SIFEN_PLAZO_TRANSMISION_HORAS=720
# Destinatario de la alerta de certificados por vencer/vencidos (cronJobs.js#alertaCertificadosPorVencer).
# Si se deja vacía, la alerta sigue quedando en el log del servidor (console.warn) pero no se envía por correo.
SIFEN_ALERTA_EMAIL=
# Directorio (relativo a la raíz del repo) donde POST /empresa y PUT /empresa/:id guardan los .p12 subidos.
# Fuera de `public/` a propósito — `public/` se sirve estático, un certificado ahí sería descargable por cualquiera.
SIFEN_CERTIFICADOS_DIR=certificados
# Directorio (relativo a la raíz del repo) donde POST /empresa y PUT /empresa/:id guardan el logo subido.
# También fuera de `public/`: no necesita ser accesible por URL directa, generarPdf.js/generarPdfRecibo.js lo leen por path.
LOGOS_DIR=logos

# Padrón RUC (importación masiva de POST /rucs/import, ver padronRucImportService.js)
# Tamaño de lote del INSERT ... ON DUPLICATE KEY UPDATE masivo.
PADRON_RUC_BATCH_SIZE=5000
# Cantidad máxima de archivos .zip aceptados por request.
PADRON_RUC_MAX_ARCHIVOS=20
# Tamaño máximo (bytes) por archivo .zip. Default 200MB.
PADRON_RUC_MAX_ARCHIVO_BYTES=209715200
# Directorio (relativo a la raíz del repo) donde se guardan temporalmente los .zip subidos
# mientras se procesan. Se borran siempre al terminar la importación (bien o mal).
PADRON_RUC_TEMP_DIR=tmp/padron-ruc

# TELEGRAM (aviso al grupo de admin — telegramService.js): documentos RECHAZADO/ERROR, fallas sistémicas
# del pipeline (cron caído, certificado vencido, cancelación rechazada, red de seguridad sin poder
# consultar SIFEN) y el aviso de APROBADOS, que va agrupado por lote (un mensaje por lote, no por documento)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EMAIL
EMAIL=
EMAIL_PW=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_FROM=

# BOT (WhatsApp) — reenvío del resultado final de SIFEN para documentos con fuente=BOT (botService.js)
# URL base del bot, sin el path del endpoint (se le agrega /documento/bulk-update)
BOT_API_URL=
BOT_API_KEY=

# DOCKER APP
DOCKER_APP_HOST_PORT=
DOCKER_APP_CONTAINER_PORT=

# PVTA (integración con la base MSSQL del PDV de El Halcón, ver src/db/dbPvta.js + POST /procesar-factura)
# Requiere Windows Authentication (Trusted Connection) + `ODBC Driver 17 for SQL Server` + el binario
# nativo msnodesqlv8 => SÓLO on-prem/Windows, NO Docker/Linux.
PVTA_DB_SERVER=localhost
PVTA_DB_DATABASE=PVTA
# Instancia con nombre (ej. SQLEXPRESS). Vacío = instancia default.
PVTA_DB_INSTANCE=
PVTA_DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
PVTA_DB_TRUST_SERVER_CERT=true
# Impresión directa del ticket al emitir desde la pantalla de caja (ver utils/imprimirJasper.js).
# Nombre EXACTO de la impresora en Windows — sacalo con: Get-Printer | Select-Object Name
# El backend manda a esa impresora el mismo reporte Jasper del que sale el PDF, así que lo impreso es
# idéntico al KUDE archivado. Sólo aplica a las NOMINADAS que dispara una persona: las innominadas del
# cron nunca se imprimen (se emiten en lotes cada 5 min, el cliente ya no está en el mostrador).
# También es la impresora que usa la REIMPRESIÓN manual desde los listados (POST /factura/reimprimir y
# POST /nota-credito/reimprimir): el destino lo fija esta variable y nunca el request, así que nadie
# puede mandar trabajos a impresoras arbitrarias de la red. GET /impresion dice si está configurada —
# es lo que consulta el front para mostrar u ocultar el botón "Reimprimir".
# Vacío = no se imprime nada y la reimpresión responde 400. Requiere que la impresora esté instalada en
# el Windows donde corre el backend: la JVM las descubre por el spooler del sistema.
IMPRESORA_TICKETS=

# CLOUDFLARE TUNNEL (dev — exponer la API local por HTTPS, ver scripts/tunnel.js / `npm run tunnel`)
# Vacío = "quick tunnel": URL pública random https://*.trycloudflare.com, sin cuenta ni dominio.
# Con un named tunnel ya creado (`cloudflared tunnel create <nombre>` + ruta DNS + ingress en tu config
# de cloudflared), poné su nombre acá para levantarlo con una URL estable en vez de la random.
CLOUDFLARE_TUNNEL_NAME=
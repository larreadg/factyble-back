// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 Int           @id @default(autoincrement())
  nombres            String        @db.VarChar(255)
  apellidos          String        @db.VarChar(255)
  email              String        @unique @db.VarChar(255)
  documento          String        @db.VarChar(20)
  telefono           String        @db.VarChar(20)
  password           String        @db.VarChar(100)
  activo             Boolean       @default(true) @db.TinyInt
  fecha_creacion     DateTime      @default(now())
  fecha_modificacion DateTime      @updatedAt
  empresa            Empresa?      @relation(fields: [empresa_id], references: [id])
  empresa_id         Int?
  facturas           Factura[]
  roles              UsuarioRol[]
  nota_credito       NotaCredito[]
  recibos            Recibo[]

  @@map("usuario")
}

model Rol {
  id                 Int          @id @default(autoincrement())
  nombre             String       @db.VarChar(255)
  fecha_creacion     DateTime     @default(now())
  fecha_modificacion DateTime     @updatedAt
  usuarios           UsuarioRol[]

  @@map("rol")
}

model UsuarioRol {
  id                 Int      @id @default(autoincrement())
  usuario            Usuario  @relation(fields: [usuario_id], references: [id])
  usuario_id         Int
  rol                Rol      @relation(fields: [rol_id], references: [id])
  rol_id             Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  @@map("usuario_rol")
}

model Empresa {
  id                        Int                @id @default(autoincrement())
  ruc                       String             @db.VarChar(255)
  nombre_empresa            String             @db.VarChar(255)
  timbrado                  String             @db.VarChar(255)
  direccion                 String             @db.VarChar(255)
  vigente_desde             DateTime
  telefono                  String             @db.VarChar(20)
  email                     String             @db.VarChar(255)
  ciudad                    String             @db.VarChar(100)
  logo                      String?            @db.VarChar(255)
  // Datos fiscales SIFEN (gap analysis MIGRATION_PLAN.md §2.2) — nullable: se backfillean antes del corte, no existen hoy
  ruc_sin_dv                String?            @db.VarChar(15)
  digito_verificador        String?            @db.VarChar(1)
  tipo_contribuyente        TipoContribuyente?
  tipo_impuesto             TipoImpuesto?
  cod_actividad_principal   String?            @db.VarChar(10)
  desc_actividad_principal  String?            @db.VarChar(255)
  cod_actividad_secundaria  String?            @db.VarChar(10)
  desc_actividad_secundaria String?            @db.VarChar(255)
  cod_moneda                String             @default("PYG") @db.VarChar(3)
  desc_moneda               String?            @db.VarChar(50)
  csc                       String?            @db.VarChar(255)
  csc_id                    String?            @db.VarChar(10)
  fecha_creacion            DateTime           @default(now())
  fecha_modificacion        DateTime           @updatedAt
  usuarios                  Usuario[]
  clientes                  ClienteEmpresa[]
  establecimientos          Establecimiento[]
  certificados              Certificado[]
  lotes                     Lote[]
  eventos_sifen             EventoSifen[]

  @@map("empresa")
}

enum TipoIdentificacion {
  CEDULA
  CARNE_DE_RESIDENCIA
  PASAPORTE
  IDENTIFICACION_TRIBUTARIA
  RUC
}

enum SituacionTributaria {
  CONTRIBUYENTE
  NO_CONTRIBUYENTE
  NO_DOMICILIADO
}

model Cliente {
  id                   Int                 @id @default(autoincrement())
  ruc                  String              @db.VarChar(255)
  documento            String              @db.VarChar(255)
  dv                   Int?                @db.TinyInt
  razon_social         String?             @db.VarChar(255)
  tipo_identificacion  TipoIdentificacion
  nombres              String              @db.VarChar(255)
  apellidos            String              @db.VarChar(255)
  pais                 String?             @db.VarChar(255)
  direccion            String?             @db.Text
  email                String?             @db.VarChar(255)
  telefono             String?             @db.VarChar(20)
  situacion_tributaria SituacionTributaria
  fecha_creacion       DateTime            @default(now())
  fecha_modificacion   DateTime            @updatedAt
  empresas             ClienteEmpresa[]

  @@map("cliente")
}

model ClienteEmpresa {
  id                 Int       @id @default(autoincrement())
  cliente            Cliente   @relation(fields: [cliente_id], references: [id])
  cliente_id         Int
  empresa            Empresa   @relation(fields: [empresa_id], references: [id])
  empresa_id         Int
  fecha_creacion     DateTime  @default(now())
  fecha_modificacion DateTime  @updatedAt
  facturas           Factura[]
  recibos            Recibo[]

  @@map("cliente_empresa")
}

enum CondicionVenta {
  CONTADO
  CREDITO
}

model Factura {
  id                    Int              @id @default(autoincrement())
  numero_factura        Int
  factura_uuid          String           @db.VarChar(255)
  usuario               Usuario          @relation(fields: [usuario_id], references: [id])
  usuario_id            Int
  cliente_empresa       ClienteEmpresa   @relation(fields: [cliente_empresa_id], references: [id])
  cliente_empresa_id    Int
  fecha_creacion        DateTime         @default(now())
  fecha_modificacion    DateTime         @updatedAt
  condicion_venta       CondicionVenta
  total_iva             Float
  total                 Float
  cdc                   String           @db.VarChar(255)
  // Legacy (API PHP) — congelado, no se le escribe más luego del corte, se dropea en el apagado (MIGRATION_PLAN.md §4.4)
  xml                   String?          @db.Text
  linkqr                String?          @db.Text
  sifen_estado          String?          @db.Text
  sifen_estado_mensaje  String?          @db.Text
  // Pipeline nativo SIFEN (MIGRATION_PLAN.md §2.2) — nullable hasta el corte, los escribe el nuevo pipeline desde Fase 2
  xml_firmado           String?          @db.MediumText
  estado_sifen          EstadoSifen?
  sifen_cod_respuesta   String?          @db.VarChar(10)
  sifen_num_transaccion String?          @db.VarChar(50)
  fecha_firma           DateTime?
  fecha_envio_sifen     DateTime?
  fecha_respuesta_sifen DateTime?
  lote_id               Int?
  lote                  Lote?            @relation(fields: [lote_id], references: [id])
  eventos_sifen         EventoSifen[]
  codigo_seguridad      String           @db.VarChar(10)
  detalles              FacturaDetalle[]
  nota_credito          NotaCredito[]
  recibo_facturas       ReciboFactura[]
  caja_id               Int?
  caja                  Caja?            @relation(fields: [caja_id], references: [id])

  @@index([lote_id])
  @@index([estado_sifen])
  @@map("factura")
}

enum Tasa {
  T0
  T5
  T10
}

model FacturaDetalle {
  id                 Int      @id @default(autoincrement())
  factura            Factura  @relation(fields: [id_factura], references: [id])
  id_factura         Int
  cantidad           Int
  precio_unitario    Float
  tasa               Tasa
  impuesto           Float
  total              Float
  descripcion        String   @db.Text
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  @@map("factura_detalle")
}

model Captcha {
  id               Int      @id @default(autoincrement())
  captcha          String   @db.VarChar(6)
  ip               String   @db.VarChar(40)
  fecha_expiracion DateTime

  @@map("captcha")
}

// Catálogo de referencia geográfica (departamento/distrito/ciudad) según la tabla
// oficial de SIFEN ("CODIGO DE REFERENCIA GEOGRAFICA" - ekuatia.set.gov.py). No tiene
// FK desde Establecimiento a propósito: Establecimiento.cod_distrito/cod_ciudad/
// cod_departamento siguen siendo texto libre, este catálogo es solo de consulta.
model Departamento {
  id                 Int      @id @default(autoincrement())
  codigo             String   @unique @db.VarChar(255)
  descripcion        String   @db.VarChar(255)
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  distritos Distrito[]

  @@map("departamento")
}

model Distrito {
  id                 Int      @id @default(autoincrement())
  codigo             String   @unique @db.VarChar(255)
  descripcion        String   @db.VarChar(255)
  departamento_id    Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  departamento Departamento @relation(fields: [departamento_id], references: [id])
  ciudades     Ciudad[]

  @@map("distrito")
}

model Ciudad {
  id                 Int      @id @default(autoincrement())
  codigo             String   @unique @db.VarChar(255)
  descripcion        String   @db.VarChar(255)
  distrito_id        Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  distrito Distrito @relation(fields: [distrito_id], references: [id])

  @@map("ciudad")
}

model Establecimiento {
  id                 Int      @id @default(autoincrement())
  nombre             String   @db.Text
  direccion          String   @db.Text
  numero_casa        String?  @db.VarChar(255)
  telefono           String?  @db.VarChar(255)
  codigo             String   @db.VarChar(255)
  cod_distrito       String   @db.VarChar(255)
  cod_ciudad         String   @db.VarChar(255)
  cod_departamento   String   @db.VarChar(255)
  empresa_id         Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  empresa Empresa @relation(fields: [empresa_id], references: [id])
  cajas   Caja[]

  @@map("establecimiento")
}

model Caja {
  id                     Int                   @id @default(autoincrement())
  nombre                 String                @db.Text
  codigo                 String                @db.VarChar(255)
  establecimiento_id     Int
  fecha_creacion         DateTime              @default(now())
  fecha_modificacion     DateTime              @updatedAt
  establecimiento        Establecimiento       @relation(fields: [establecimiento_id], references: [id])
  secuencia_factura      SecuenciaFactura?
  secuencia_nota_credito SecuenciaNotaCredito?
  secuencia_recibo       SecuenciaRecibo?
  facturas               Factura[]
  nota_credito           NotaCredito[]
  recibos                Recibo[]

  @@map("caja")
}

model SecuenciaFactura {
  caja_id            Int      @id
  valor              Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt
  caja               Caja     @relation(fields: [caja_id], references: [id])

  @@map("secuencia_factura")
}

model SecuenciaRecibo {
  caja_id            Int      @id
  valor              Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt
  caja               Caja     @relation(fields: [caja_id], references: [id])

  @@map("secuencia_recibo")
}

model NotaCredito {
  id                    Int                  @id @default(autoincrement())
  numero_nota_credito   Int
  factura_id            Int
  nota_credito_uuid     String               @db.VarChar(255)
  usuario               Usuario              @relation(fields: [usuario_id], references: [id])
  usuario_id            Int
  total_iva             Float
  total                 Float
  cdc                   String               @db.VarChar(255)
  // Legacy (API PHP) — congelado, no se le escribe más luego del corte, se dropea en el apagado (MIGRATION_PLAN.md §4.4)
  xml                   String?              @db.Text
  linkqr                String?              @db.Text
  sifen_estado          String?              @db.Text
  sifen_estado_mensaje  String?              @db.Text
  // Pipeline nativo SIFEN (MIGRATION_PLAN.md §2.2) — nullable hasta el corte, los escribe el nuevo pipeline desde Fase 2
  xml_firmado           String?              @db.MediumText
  estado_sifen          EstadoSifen?
  sifen_cod_respuesta   String?              @db.VarChar(10)
  sifen_num_transaccion String?              @db.VarChar(50)
  fecha_firma           DateTime?
  fecha_envio_sifen     DateTime?
  fecha_respuesta_sifen DateTime?
  lote_id               Int?
  lote                  Lote?                @relation(fields: [lote_id], references: [id])
  eventos_sifen         EventoSifen[]
  codigo_seguridad      String               @db.VarChar(10)
  fecha_creacion        DateTime             @default(now())
  fecha_modificacion    DateTime             @updatedAt
  factura               Factura              @relation(fields: [factura_id], references: [id])
  nota_credito_detalle  NotaCreditoDetalle[]
  recibo_notas_credito  ReciboNotaCredito[]
  caja_id               Int?
  caja                  Caja?                @relation(fields: [caja_id], references: [id])

  @@index([lote_id])
  @@index([estado_sifen])
  @@map("nota_credito")
}

model NotaCreditoDetalle {
  id                 Int         @id @default(autoincrement())
  nota_credito_id    Int
  cantidad           Int
  precio_unitario    Float
  tasa               Tasa
  impuesto           Float
  total              Float
  descripcion        String      @db.VarChar(255)
  fecha_creacion     DateTime    @default(now())
  fecha_modificacion DateTime    @updatedAt
  nota_credito       NotaCredito @relation(fields: [nota_credito_id], references: [id])

  @@map("nota_credito_detalle")
}

model Recibo {
  id                   Int                   @id @default(autoincrement())
  numero_recibo        Int
  recibo_uuid          String                @db.VarChar(255)
  cliente_empresa_id   Int
  cliente_empresa      ClienteEmpresa        @relation(fields: [cliente_empresa_id], references: [id])
  usuario_id           Int
  usuario              Usuario               @relation(fields: [usuario_id], references: [id])
  total_efectivo       Decimal               @default(0) @db.Decimal(15, 2)
  total_cheques        Decimal               @default(0) @db.Decimal(15, 2)
  total_transferencias Decimal               @default(0) @db.Decimal(15, 2)
  total                Decimal               @db.Decimal(15, 2)
  total_letras         String                @db.VarChar(255)
  concepto             String?               @db.Text
  fecha_emision        DateTime              @default(now())
  fecha_creacion       DateTime              @default(now())
  fecha_modificacion   DateTime              @updatedAt
  caja_id              Int?
  caja                 Caja?                 @relation(fields: [caja_id], references: [id])
  facturas             ReciboFactura[]
  notas_credito        ReciboNotaCredito[]
  cheques              ReciboCheque[]
  transferencias       ReciboTransferencia[]

  @@unique([caja_id, numero_recibo], map: "uk_recibo_caja_numero")
  @@map("recibo")
}

model ReciboFactura {
  id                 Int      @id @default(autoincrement())
  recibo_id          Int
  factura_id         Int
  monto_aplicado     Decimal  @db.Decimal(15, 2)
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt
  recibo             Recibo   @relation(fields: [recibo_id], references: [id])
  factura            Factura  @relation(fields: [factura_id], references: [id])

  @@unique([recibo_id, factura_id], map: "uk_recibo_factura")
  @@index([factura_id])
  @@map("recibo_factura")
}

model ReciboNotaCredito {
  id                 Int         @id @default(autoincrement())
  recibo_id          Int
  nota_credito_id    Int
  monto_aplicado     Decimal     @db.Decimal(15, 2)
  fecha_creacion     DateTime    @default(now())
  fecha_modificacion DateTime    @updatedAt
  recibo             Recibo      @relation(fields: [recibo_id], references: [id])
  nota_credito       NotaCredito @relation(fields: [nota_credito_id], references: [id])

  @@unique([recibo_id, nota_credito_id], map: "uk_recibo_nota_credito")
  @@index([nota_credito_id])
  @@map("recibo_nota_credito")
}

model ReciboCheque {
  id                 Int      @id @default(autoincrement())
  recibo_id          Int
  banco              String   @db.VarChar(120)
  numero_cheque      String   @db.VarChar(50)
  monto              Decimal  @db.Decimal(15, 2)
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt
  recibo             Recibo   @relation(fields: [recibo_id], references: [id])

  @@index([recibo_id])
  @@map("recibo_cheque")
}

model ReciboTransferencia {
  id                 Int      @id @default(autoincrement())
  recibo_id          Int
  banco              String   @db.VarChar(120)
  numero_referencia  String   @db.VarChar(50)
  monto              Decimal  @db.Decimal(15, 2)
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt
  recibo             Recibo   @relation(fields: [recibo_id], references: [id])

  @@index([recibo_id])
  @@map("recibo_transferencia")
}

model SecuenciaNotaCredito {
  caja_id            Int      @id
  valor              Int
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt
  caja               Caja     @relation(fields: [caja_id], references: [id])

  @@map("secuencia_nota_credito")
}

// ============================================================================
// Dominio SIFEN (MIGRATION_PLAN.md — absorción de factyble-api)
// ============================================================================

enum EstadoSifen {
  GENERADO
  FIRMANDO
  FIRMADO
  ENCOLADO
  ENVIADO
  APROBADO
  RECHAZADO
  ERROR
  CANCELADO
}

enum TipoContribuyente {
  FISICA
  JURIDICA
}

enum TipoImpuesto {
  IVA
  ISC
  RENTA
  NINGUNO
  IVA_RENTA
}

enum EstadoCertificado {
  VIGENTE
  POR_VENCER
  VENCIDO
  REVOCADO
}

model Certificado {
  id                 Int               @id @default(autoincrement())
  empresa            Empresa           @relation(fields: [empresa_id], references: [id])
  empresa_id         Int
  alias              String            @db.VarChar(100)
  archivo            String            @db.VarChar(500)
  // Cifrada a nivel aplicación (secreto de cifrado en variable de entorno) — nunca texto plano
  clave              String            @db.VarChar(500)
  fecha_vencimiento  DateTime
  activo             Boolean           @default(true)
  estado             EstadoCertificado @default(VIGENTE)
  fecha_creacion     DateTime          @default(now())
  fecha_modificacion DateTime          @updatedAt

  @@index([empresa_id])
  @@index([empresa_id, activo])
  @@map("certificado")
}

enum TipoDocumentoSifen {
  FACTURA
  NOTA_CREDITO
}

enum EstadoLote {
  CONSTRUIDO
  ENVIANDO
  ENVIADO
  CONSULTADO
  AGOTADO
}

model Lote {
  id                     Int                @id @default(autoincrement())
  empresa                Empresa            @relation(fields: [empresa_id], references: [id])
  empresa_id             Int
  secuencia              String             @unique @db.VarChar(50)
  tipo_doc               TipoDocumentoSifen
  estado                 EstadoLote         @default(CONSTRUIDO)
  archivo_zip            String?            @db.VarChar(255)
  sifen_numero_lote      String?            @db.VarChar(50)
  sifen_envio_codigo     String?            @db.VarChar(10)
  sifen_envio_mensaje    String?            @db.Text
  sifen_consulta_codigo  String?            @db.VarChar(100)
  sifen_consulta_mensaje String?            @db.MediumText
  intentos_envio         Int                @default(0)
  proximo_intento_en     DateTime?
  ultimo_error           String?            @db.Text
  fecha_creacion         DateTime           @default(now())
  fecha_modificacion     DateTime           @updatedAt
  facturas               Factura[]
  notas_credito          NotaCredito[]

  @@index([empresa_id])
  @@index([estado])
  @@map("lote")
}

enum TipoEventoSifen {
  CANCELACION
  INACTIVACION_RANGO
  NOMINACION_RECEPTOR
  INUTILIZACION
  CONFORMIDAD
  DISCONFORMIDAD
  DESCONOCIMIENTO
  NOTIFICACION
}

model EventoSifen {
  id                      Int             @id @default(autoincrement())
  empresa                 Empresa         @relation(fields: [empresa_id], references: [id])
  empresa_id              Int
  tipo_evento             TipoEventoSifen
  factura_id              Int?
  factura                 Factura?        @relation(fields: [factura_id], references: [id])
  nota_credito_id         Int?
  nota_credito            NotaCredito?    @relation(fields: [nota_credito_id], references: [id])
  // Payload específico del tipo de evento (rango/timbrado para inactivación, RUC/nombre para nominación, etc.)
  // — JSON en vez de columnas dispersas nulleable, ver antipatrón V en MIGRATION_PLAN.md
  datos_evento            Json?
  motivo                  String?         @db.Text
  secuencia_sifen         String?         @db.VarChar(50)
  xml_firmado             String?         @db.MediumText
  sifen_respuesta_codigo  String?         @db.VarChar(10)
  sifen_respuesta_mensaje String?         @db.Text
  sifen_respuesta_xml     String?         @db.MediumText
  intentos_envio          Int             @default(0)
  proximo_intento_en      DateTime?
  ultimo_error            String?         @db.Text
  fecha_creacion          DateTime        @default(now())
  fecha_modificacion      DateTime        @updatedAt

  @@index([empresa_id])
  @@index([factura_id])
  @@index([nota_credito_id])
  @@map("evento_sifen")
}

enum EntidadSifen {
  FACTURA
  NOTA_CREDITO
  LOTE
  EVENTO
}

enum OperacionSifen {
  FIRMA
  ENVIO_LOTE
  CONSULTA_LOTE
  CONSULTA_DOCUMENTO
  EVENTO
}

model SifenTrazabilidad {
  id               Int            @id @default(autoincrement())
  entidad_tipo     EntidadSifen
  entidad_id       Int
  operacion        OperacionSifen
  request_payload  String?        @db.MediumText
  response_payload String?        @db.MediumText
  codigo_respuesta String?        @db.VarChar(20)
  exitoso          Boolean
  fecha_creacion   DateTime       @default(now())

  @@index([entidad_tipo, entidad_id])
  @@index([fecha_creacion])
  @@map("sifen_trazabilidad")
}

// ============================================================================
// Padrón de RUC (importación masiva desde los .zip publicados por la SET/DNIT)
// ============================================================================

// `ruc` es el RUC SIN dígito verificador (identificador único de actualización del
// padrón); el RUC completo tal como lo emite SIFEN se arma en tiempo de lectura
// concatenando `${ruc}-${digito_verificador}`, no se persiste duplicado.
model PadronRuc {
  id                 Int      @id @default(autoincrement())
  ruc                String   @unique @db.VarChar(15)
  razon_social       String   @db.VarChar(255)
  digito_verificador String   @db.VarChar(2)
  ruc_anterior       String?  @db.VarChar(20)
  estado             String   @db.VarChar(50)
  fecha_creacion     DateTime @default(now())
  fecha_modificacion DateTime @updatedAt

  @@index([estado])
  @@map("padron_ruc")
}
